# =============================================================================
# 版本一 · 单阶段全量镜像：构建/运行工具全部带进运行时（体积最大，最常见反面教材）
# =============================================================================
FROM python:3.12
WORKDIR /app
COPY app/ .
# 构建痕迹：pip 缓存、apt 列表全部留在镜像里
RUN pip install --no-cache-dir -r requirements.txt
EXPOSE 8080
CMD ["python", "flask_app.py"]
