  "cards": [
    {
      "dot": "emerald",
      "title": "锁是数据",
      "items": [
        "tflock 是桶里的普通对象，cat 出来就是持锁者信息",
        "pg 的锁在 pg_locks 视图里，S3 系的锁在桶里——都看得见",
        "锁对象的存在与否就是互斥的唯一依据"
      ]
    },
    {
      "dot": "rose",
      "title": "滞留与真解",
      "items": [
        "SIGKILL 持锁者后锁对象仍在——与 pg 的连接断自动回收相反",
        "force-unlock 删掉锁对象，S3 系上它是真解（pg 上是假成功）",
        "滞留锁不只 apply 会留：plan 崩溃同样会留"
      ]
    },
    {
      "dot": "orange",
      "title": "远程性",
      "items": [
        "杀掉 ObjStor 进程再拉起，state 完好——数据在对象存储不在进程",
        "state 对象写入是原子 PUT，不会写一半",
        "进程只负责服务数据，数据才是真相"
      ]
    }
  ]
}
