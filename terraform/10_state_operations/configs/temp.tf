# =============================================================================
# temp.tf — state rm 摘除演示用的临时资源（只在 rm 阶段复制进工作区）
#
# 剧情：terraform apply 正常创建它 → state 里有了记录 → state rm 把记录
# 摘掉 → 容器还活着、但 Terraform 已经"不认识"它了 → 下一次 plan 会
# 试图重新创建一台同名容器（名字冲突！）。这个危险面就是本阶段的考点。
# 演示完毕：删掉本文件 + 删掉容器，账实重新对齐。
# =============================================================================

resource "docker_container" "temp" {
  name  = "tf10-temp"
  # 字面量镜像名：rm 阶段独立可跑，不受前面改名演示（image 资源地址变化）影响
  image = "alpine:3"

  command  = ["sleep", "infinity"]
  must_run = true
}
