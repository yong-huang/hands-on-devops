  "cards": [
    {
      "dot": "emerald",
      "title": "锁的语义",
      "items": [
        "pg_advisory_lock 是会话级：连接在锁在，连接亡锁归西",
        "拒绝报错自带 Lock Info——Lock ID 由此取得",
        "pg_locks 表里 advisory 锁当场可查，不是黑盒"
      ]
    },
    {
      "dot": "rose",
      "title": "卡死与强解",
      "items": [
        "SIGSTOP 是假死：进程在、连接在、锁也在——锁卡死的原型",
        "terraform force-unlock 报成功但锁不动（本机实测）",
        "真正强解是 pg_terminate_backend 掐断持有者连接"
      ]
    },
    {
      "dot": "orange",
      "title": "pg vs S3+DynamoDB",
      "items": [
        "pg：进程死 → 连接断 → 锁自动回收，少一种卡死事故",
        "S3+DynamoDB：锁对象是数据，持有者死了必须 force-unlock",
        "两种后端的锁差异是后端选型的核心考点"
      ]
    }
  ]
}